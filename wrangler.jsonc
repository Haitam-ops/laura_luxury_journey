{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laura-luxury-journey",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/en/*",
      "/fr/*",
      "/es/*",
      "/de/*",
      "/it/*",
      "/pt/*",
      "/nl/*",
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  }
}
